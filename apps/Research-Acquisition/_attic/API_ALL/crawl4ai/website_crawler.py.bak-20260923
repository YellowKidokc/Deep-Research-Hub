"""
Website Crawler - Download entire website recursively
Saves all pages as Markdown
"""

import asyncio
from crawl4ai import AsyncWebCrawler
from pathlib import Path
import sys
from datetime import datetime
from urllib.parse import urljoin, urlparse
from bs4 import BeautifulSoup
import re

async def crawl_website(start_url, max_depth, output_dir):
    """Recursively crawl entire website"""
    output_path = Path(output_dir)
    output_path.mkdir(parents=True, exist_ok=True)
    
    base_domain = urlparse(start_url).netloc
    visited_urls = set()
    to_visit = [(start_url, 0)]  # (url, depth)
    downloaded_count = 0
    
    print(f"\n{'='*70}")
    print(f"DOWNLOADING WEBSITE: {start_url}")
    print(f"Base domain: {base_domain}")
    print(f"Max depth: {max_depth}")
    print(f"{'='*70}\n")
    
    async with AsyncWebCrawler(verbose=True) as crawler:
        while to_visit:
            current_url, depth = to_visit.pop(0)
            
            if current_url in visited_urls:
                continue
            
            if depth > max_depth:
                continue
            
            visited_urls.add(current_url)
            
            print(f"\n[Depth {depth}] [{downloaded_count+1}] {current_url}")
            
            try:
                result = await crawler.arun(url=current_url)
                
                if result.success:
                    # Save page
                    filename = f"page_{downloaded_count:04d}_depth{depth}.md"
                    page_file = output_path / filename
                    
                    header = f"# {result.title or 'Untitled'}\n\n"
                    header += f"**URL:** {current_url}\n\n"
                    header += f"**Depth:** {depth}\n\n"
                    header += f"**Downloaded:** {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n"
                    header += "---\n\n"
                    
                    page_file.write_text(header + result.markdown, encoding='utf-8')
                    downloaded_count += 1
                    print(f"  ✓ Saved: {filename}")
                    
                    # Extract links for next depth level
                    if depth < max_depth:
                        soup = BeautifulSoup(result.html, 'html.parser')
                        
                        for link in soup.find_all('a', href=True):
                            href = link['href']
                            absolute_url = urljoin(current_url, href)
                            
                            # Only follow links on same domain
                            if urlparse(absolute_url).netloc == base_domain:
                                # Skip anchors, javascript, etc
                                if not absolute_url.startswith(('http://', 'https://')):
                                    continue
                                if '#' in absolute_url:
                                    absolute_url = absolute_url.split('#')[0]
                                
                                if absolute_url not in visited_urls:
                                    to_visit.append((absolute_url, depth + 1))
                else:
                    print(f"  ✗ Failed: {result.error_message or 'Unknown error'}")
                    
            except Exception as e:
                print(f"  ✗ Error: {str(e)}")
    
    # Create index
    index_file = output_path / "index.md"
    with open(index_file, 'w', encoding='utf-8') as f:
        f.write(f"# Website Download Index\n\n")
        f.write(f"**Website:** {start_url}\n\n")
        f.write(f"**Base Domain:** {base_domain}\n\n")
        f.write(f"**Downloaded:** {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
        f.write(f"**Total Pages:** {downloaded_count}\n\n")
        f.write(f"**Max Depth:** {max_depth}\n\n")
        f.write("---\n\n")
        f.write("## Downloaded Pages\n\n")
        
        for i in range(downloaded_count):
            f.write(f"- page_{i:04d}_depth*.md\n")
    
    print(f"\n{'='*70}")
    print(f"WEBSITE DOWNLOAD COMPLETE")
    print(f"{'='*70}")
    print(f"Pages downloaded: {downloaded_count}")
    print(f"Saved to: {output_path}")
    print(f"Index: {index_file}")
    print(f"{'='*70}\n")

if __name__ == "__main__":
    if len(sys.argv) < 4:
        print("Usage: python website_crawler.py <url> <max_depth> <output_dir>")
        sys.exit(1)
    
    url = sys.argv[1]
    max_depth = int(sys.argv[2])
    output_dir = sys.argv[3]
    
    asyncio.run(crawl_website(url, max_depth, output_dir))
