{
  "port": 8765,
  "mode": "transcript",
  "ytbsd_dir": "../../yt-transcript-downloader",
  "out_dir": "../../../../data/youtube",
  "hub_root": "../../../..",
  "summary": {
    "set": "Y",
    "slot": 1
  },
  "ytbsd_args": [
    "--free-proxies"
  ],
  "batch_size": 5,
  "download_dir": "D:/YouTube_Downloads",
  "format": "bestvideo[height<=1080]+bestaudio/best[height<=1080]",
  "write_subs": true,
  "concurrent_downloads": 5,
  "proxies": [],
  "proxy_mode": "rotate",
  "retries_per_proxy": 1,
  "extra_args": [
    "--no-playlist",
    "--embed-metadata"
  ]
}
