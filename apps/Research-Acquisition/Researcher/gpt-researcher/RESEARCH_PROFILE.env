# HIGH-EVIDENCE PROFILE
# These are research-depth controls, not API keys. Larger settings cost more and run longer.
MAX_ITERATIONS=6
MAX_SEARCH_RESULTS_PER_QUERY=10
MAX_SUBTOPICS=7
TOTAL_WORDS=5000
CURATE_SOURCES=true
DEEP_RESEARCH_BREADTH=5
DEEP_RESEARCH_DEPTH=3
DEEP_RESEARCH_CONCURRENCY=4
FAST_TOKEN_LIMIT=8000
SMART_TOKEN_LIMIT=24000
STRATEGIC_TOKEN_LIMIT=12000
SUMMARY_TOKEN_LIMIT=1200
BROWSE_CHUNK_MAX_LENGTH=16000
LOCAL_DOCUMENT_BATCH_SIZE=24
SIMILARITY_THRESHOLD=0.35
MCP_STRATEGY=deep
REASONING_EFFORT=high
