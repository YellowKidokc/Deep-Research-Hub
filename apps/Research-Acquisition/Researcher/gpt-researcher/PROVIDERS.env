# Which providers GPT Researcher uses. No keys here: DEEPSEEK_API_KEY and
# TAVILY_API_KEY come from the Windows user environment.
# Loaded by main.py and windows_launcher.py. Anything already set in the
# environment or in .env wins over these lines.
# Without them a bare launch silently falls back to OpenAI defaults.
FAST_LLM=deepseek:deepseek-chat
SMART_LLM=deepseek:deepseek-chat
STRATEGIC_LLM=deepseek:deepseek-chat
EMBEDDING=ollama:nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
RETRIEVER=tavily
