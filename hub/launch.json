  {
    "id": "acquire.scrape",
    "label": "Acquisition: Scrape one page to markdown",
    "app": "deepcrawl",
    "cwd": ".",
    "program": "python",
    "args": [
      "drh_crawl.py",
      "{url}",
      "--out",
      "{data}/crawl",
      "--pages",
