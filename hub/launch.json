[
  {
    "id": "youtube.grab",
    "label": "YouTube: ytgrab.py -> data/youtube, then baseline summary",
    "app": "Research-Acquisition",
    "cwd": "yt-transcript-downloader",
    "program": "python",
    "args": [
      "ytgrab.py",
      "{url}",
      "--out",
      "{data}/youtube",
      "--limit={limit}"
    ],
    "params": [
      {
        "name": "url",
        "label": "Video or channel URL",
        "kind": "youtube_url"
      },
      {
        "name": "limit",
        "label": "At most N videos this run (blank = all)",
        "kind": "count",
        "optional": true
      }
    ],
    "then": [
      {
        "program": "python",
        "cwd": ".",
        "args": [
          "prompts/run_slot.py",
          "Y",
          "1",
          "--dir",
          "{data}/youtube",
          "--since",
          "{started}",
          "--append"
        ]
      }
    ]
  },
  {
    "id": "gptr.server",
    "label": "GPT Researcher server (127.0.0.1:8000)",
    "app": "Research-Acquisition",
    "cwd": "Researcher/gpt-researcher",
    "program": "python",
    "args": [
      "-m",
      "uvicorn",
      "main:app",
      "--host",
      "127.0.0.1",
      "--port",
      "8000"
    ]
  },
  {
    "id": "deep.queue",
    "label": "Deep Research: run the job queue (data/jobs)",
    "app": "Research-Acquisition",
    "cwd": "Researcher/gpt-researcher",
    "program": "python",
    "args": [
      "drh_queue.py",
      "--jobs",
      "{data}/jobs",
      "--out",
      "{data}/deep_research",
      "--parallel={parallel}"
    ],
    "params": [
      {
        "name": "parallel",
        "label": "Jobs at once (blank = 1)",
        "kind": "count",
        "optional": true
      }
    ]
  },
  {
    "id": "deep.check",
    "label": "Deep Research: check the job queue (dry run)",
    "app": "Research-Acquisition",
    "cwd": "Researcher/gpt-researcher",
    "program": "python",
    "args": [
      "drh_queue.py",
      "--jobs",
      "{data}/jobs",
      "--out",
      "{data}/deep_research",
      "--dry-run"
    ]
  },
  {
    "id": "deep.retry",
    "label": "Deep Research: put failed jobs back in the queue",
    "app": "Research-Acquisition",
    "cwd": "Researcher/gpt-researcher",
    "program": "python",
    "args": [
      "drh_queue.py",
      "--jobs",
      "{data}/jobs",
      "--out",
      "{data}/deep_research",
      "--retry-failed"
    ]
  },
  {
    "id": "pipeline-workflows.help",
    "label": "pipeline-workflows: evaluate_question.py --help",
    "app": "pipeline-workflows",
    "cwd": ".",
    "program": "python",
    "args": [
      "evaluate_question.py",
      "--help"
    ]
  },
  {
    "id": "research-acquisition.ytgrab-help",
    "label": "Research-Acquisition: ytgrab.py --help",
    "app": "Research-Acquisition",
    "cwd": "yt-transcript-downloader",
    "program": "python",
    "args": [
      "ytgrab.py",
      "--help"
    ]
  },
  {
    "id": "axiom.navigator",
    "label": "Axiom Navigator (the finished canon) on 127.0.0.1:8774",
    "app": "Axiom-Navigator",
    "cwd": ".",
    "program": "node",
    "args": [
      "local-server.mjs"
    ]
  },
  {
    "id": "axiom.build",
    "label": "Axiom Navigator: rebuild the canon site after editing canon docs",
    "app": "Axiom-Navigator",
    "cwd": ".",
    "program": "cmd",
    "args": [
      "/c",
      "npm",
      "run",
      "build"
    ]
  },
  {
    "id": "openwriter.server",
    "label": "OpenWriter (the Writer surface) on 127.0.0.1:5050",
    "app": "openwriter",
    "cwd": ".",
    "program": "node",
    "args": [
      "packages/openwriter/dist/bin/pad.js",
      "--port",
      "5050",
      "--no-open",
      "--plugins",
      "@openwriter/plugin-drh"
    ]
  },
  {
    "id": "deepcrawl.server",
    "label": "Deepcrawl API worker (page -> markdown, links) on 127.0.0.1:8080",
    "app": "deepcrawl",
    "cwd": "apps/workers/v0",
    "program": "cmd",
    "args": [
      "/c",
      "pnpm",
      "exec",
      "wrangler",
      "dev",
      "-c",
      "wrangler.local.jsonc"
    ]
  },
  {
    "id": "acquire.scrape",
    "label": "Acquisition: Scrape one page to markdown",
    "app": "deepcrawl",
    "cwd": ".",
    "program": "python",
    "args": [
      "drh_crawl.py",
      "{url}",
      "--out",
      "{data}/crawl",
      "--pages",
      "1"
    ],
    "params": [
      {
        "name": "url",
        "label": "Web page URL",
        "kind": "web_url"
      }
    ]
  },
  {
    "id": "acquire.links",
    "label": "Acquisition: Links on a page (internal + external) and the site tree",
    "app": "deepcrawl",
    "cwd": ".",
    "program": "python",
    "args": [
      "drh_crawl.py",
      "{url}",
      "--out",
      "{data}/links",
      "--links-only"
    ],
    "params": [
      {
        "name": "url",
        "label": "Web page URL",
        "kind": "web_url"
      }
    ]
  },
  {
    "id": "acquire.crawl",
    "label": "Acquisition: Crawl a site (same host) to markdown",
    "app": "deepcrawl",
    "cwd": ".",
    "program": "python",
    "args": [
      "drh_crawl.py",
      "{url}",
      "--out",
      "{data}/crawl",
      "--pages={pages}",
      "--depth={depth}"
    ],
    "params": [
      {
        "name": "url",
        "label": "Web page URL",
        "kind": "web_url"
      },
      {
        "name": "pages",
        "label": "Pages to read (default 1)",
        "kind": "count",
        "optional": true
      },
      {
        "name": "depth",
        "label": "Link hops from the start page (default 3)",
        "kind": "count",
        "optional": true
      }
    ]
  },
  {
    "id": "search.marginalia",
    "label": "Search: Marginalia result links (optionally read the top N)",
    "app": "MarginaliaSearch",
    "cwd": ".",
    "program": "python",
    "args": [
      "drh_search.py",
      "{query}",
      "--out",
      "{data}/search",
      "--count={count}",
      "--read={read}"
    ],
    "params": [
      {
        "name": "query",
        "label": "Search words",
        "kind": "query"
      },
      {
        "name": "count",
        "label": "Results (default 30, max 100)",
        "kind": "count",
        "optional": true
      },
      {
        "name": "read",
        "label": "Also read the top N to markdown",
        "kind": "count",
        "optional": true
      }
    ]
  }
]
