    ],
    "params": [
      {
        "name": "url",
        "label": "Web page URL",
        "kind": "web_url"
      }
    ]
  },
  {
    "id": "acquire.links",
    "label": "Acquisition: Links on a page (internal + external) and the site tree",
    "app": "deepcrawl",
    "cwd": ".",
    "program": "python",
    "args": [
      "drh_crawl.py",
      "{url}",
      "--out",
      "{data}/links",
      "--links-only"
    ],
    "params": [
      {
        "name": "url",
        "label": "Web page URL",
        "kind": "web_url"
      }
    ]
  },
  {
    "id": "acquire.crawl",
    "label": "Acquisition: Crawl a site (same host) to markdown",
    "app": "deepcrawl",
    "cwd": ".",
    "program": "python",
    "args": [
      "drh_crawl.py",
      "{url}",
      "--out",
      "{data}/crawl",
      "--pages={pages}",
      "--depth={depth}"
    ],
    "params": [
      {
        "name": "url",
        "label": "Web page URL",
        "kind": "web_url"
      },
      {
        "name": "pages",
        "label": "Pages to read (default 1)",
        "kind": "count",
        "optional": true
      },
      {
        "name": "depth",
        "label": "Link hops from the start page (default 3)",
        "kind": "count",
        "optional": true
      }
    ]
  },
  {
    "id": "search.marginalia",
