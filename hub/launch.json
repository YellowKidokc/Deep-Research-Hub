        "kind": "query"
      },
      {
        "name": "count",
        "label": "Results (default 30, max 100)",
        "kind": "count",
        "optional": true
      },
      {
        "name": "read",
        "label": "Also read the top N to markdown",
        "kind": "count",
        "optional": true
      }
    ]
  },
